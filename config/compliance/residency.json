{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.0.0",
  "description": "Declarative cold storage evidence residency rules across CAGE jurisdictions.",
  "regions": {
    "US_FED": {
      "jurisdiction": "United States (Federal Reserve / NIST SP 800-53)",
      "env_var": "EVIDENCE_COLD_STORE_BUCKET_US",
      "allowed_locations": [
        "us-central1",
        "us-east1",
        "us-east4",
        "us-west1",
        "us-west2",
        "us-west3",
        "us-west4",
        "us-east-1",
        "us-east-2",
        "us-west-1",
        "us-west-2"
      ]
    },
    "EU_ECB": {
      "jurisdiction": "European Union (European Central Bank / GDPR Art. 44)",
      "env_var": "EVIDENCE_COLD_STORE_BUCKET_EU",
      "allowed_locations": [
        "europe-west1",
        "europe-west3",
        "europe-west4",
        "europe-central2",
        "eu-central-1",
        "eu-west-1",
        "eu-west-2",
        "eu-west-3"
      ]
    },
    "APAC_MAS": {
      "jurisdiction": "Asia-Pacific (Monetary Authority of Singapore / MAS TRM §4.2)",
      "env_var": "EVIDENCE_COLD_STORE_BUCKET_APAC",
      "allowed_locations": [
        "asia-southeast1",
        "asia-southeast2",
        "asia-east1",
        "ap-southeast-1",
        "ap-southeast-2"
      ]
    }
  }
}
