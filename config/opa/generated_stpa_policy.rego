stpa_violations contains msg if msg := stpa_violation_uca_6
stpa_violations contains msg if msg := stpa_violation_uca_7

stpa_allow if {
    count(stpa_violations) == 0
}

# ---------------------------------------------------------------------------
# RBAC rules (compiled from stpa_control_structure.yaml rbac_rules)
# ---------------------------------------------------------------------------

# Role: junior
rbac_allow_junior_trade if {
    input.action == "execute_trade"
    lower(input.trader_role) == "junior"
    input.amount <= 5000
    input.currency != "BTC"
}

rbac_review_junior_trade if {
    input.action == "execute_trade"
    lower(input.trader_role) == "junior"
    input.amount > 5000
    input.amount <= 10000
    input.currency != "BTC"
}

# Role: senior
rbac_allow_senior_trade if {
    input.action == "execute_trade"
    lower(input.trader_role) == "senior"
    input.amount <= 500000
    input.currency != "BTC"
}

rbac_review_senior_trade if {
    input.action == "execute_trade"
    lower(input.trader_role) == "senior"
    input.amount > 500000
    input.amount <= 1000000
    input.currency != "BTC"
}
