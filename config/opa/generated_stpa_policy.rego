# --- Action: write_db ---
# UCA-1: Agent executes write operation without a signed approval token.
stpa_violation_uca_1 := msg if {
    input.action == "write_db"
    not input.approval_token
    msg := "UCA-1: write_db requires a signed approval_token."
}

# --- Action: execute_trade ---
# UCA-2: Agent executes trade with stale market data (latency > threshold).
stpa_violation_uca_2 := msg if {
    input.action == "execute_trade"
    input.latency_ms > input._thresholds.stpa_max_latency_ms  # threshold from governance_thresholds.json:stpa.max_latency_ms
    msg := "UCA-2: Market data latency exceeds maximum allowable threshold."
}

# UCA-5: Agent executes buy order when daily drawdown exceeds limit.
stpa_violation_uca_5 := msg if {
    input.action == "execute_trade"
    input.drawdown > input._thresholds.stpa_uca5_drawdown_threshold_pct  # threshold from governance_thresholds.json:stpa.uca5_drawdown_threshold_pct
    msg := "UCA-5: Drawdown exceeds maximum threshold — trade blocked."
}

# UCA-6: Agent submits market order exceeding allowable fraction of daily volume.
stpa_violation_uca_6 := msg if {
    input.action == "execute_trade"
    # composite: order_size > threshold_ref(stpa.uca6_max_order_volume_fraction) * daily_vol
    # NOTE: complex composite condition — enforce via Python validator.
    false  # placeholder: evaluated in STPAValidator
    msg := "UCA-6: Order size exceeds maximum daily volume fraction — slippage risk."
}

# --- Action: prompt_injection_check ---
# UCA-7: Adversarial prompt injection score exceeds detection threshold.
stpa_violation_uca_7 := msg if {
    input.action == "prompt_injection_check"
    input.semantic_score > 0.85
    msg := "UCA-7: Prompt injection detected — governance violation."
}

# ---------------------------------------------------------------------------
# Aggregate: deny if any STPA violation fires
# ---------------------------------------------------------------------------

stpa_violations contains msg if msg := stpa_violation_uca_1
stpa_violations contains msg if msg := stpa_violation_uca_2
