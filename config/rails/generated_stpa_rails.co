# ---------------------------------------------------------------------------
# Action declarations
# ---------------------------------------------------------------------------

action MaskPIIAction
action LogSafetyAuditAction

action BlockPiiOutputCheckAction  # UCA-3
action BlockPartialTransactionCheckAction  # UCA-4
action BlockPromptInjectionCheckAction  # UCA-7

# ---------------------------------------------------------------------------
# Safety flows
# ---------------------------------------------------------------------------

# UCA-3: Agent outputs PII to user interface.
flow block_pii_output
  bot say "I cannot share personal information in my response."
  await LogSafetyAuditAction

# UCA-4: Agent debits account but fails to credit asset (atomic failure).
flow block_partial_transaction
  bot say "Transaction integrity check failed. Stopping execution."
  await LogSafetyAuditAction

# UCA-7: Adversarial prompt injection score exceeds detection threshold.
flow block_prompt_injection
  bot say "I cannot process this request as it appears to be attempting to override my instructions."
  await LogSafetyAuditAction

# ---------------------------------------------------------------------------
# Composite output guardrail — invoked on every bot response
# ---------------------------------------------------------------------------

flow stpa_output_guardrail
  match bot said $msg
  # Pattern: output_contains_pii
  await BlockPiiOutputCheckAction as $check_uca_3
  if $check_uca_3.detected == true
    await block_pii_output

  # Pattern: partial_transaction_detected
  await BlockPartialTransactionCheckAction as $check_uca_4
  if $check_uca_4.detected == true
    await block_partial_transaction

