# Partner Integration Sandbox Configuration
#
# This template documents all environment variables required for live partner
# integration testing across Provider 01 through Provider 06 and Actuator 01.
#
# USAGE:
#   1. Copy this file to `partner-sandbox.env` (gitignored)
#   2. Fill in actual sandbox credentials
#   3. Source before running: source config/environments/partner-sandbox.env
#   4. Execute: make test-partner
#
# SECURITY:
#   - Never commit partner-sandbox.env to version control
#   - Rotate credentials regularly
#   - Use sandbox/test environments only — never production credentials

# ---------------------------------------------------------------------------
# Provider 01 (FlowSignal / EU ECB Normative Provider)
# ---------------------------------------------------------------------------

# FlowSignal API endpoint (sandbox)
PROVIDER_01_ENDPOINT=https://provider-01.sandbox.example.com/api/cage

# FlowSignal API key (obtain from FlowSignal sandbox dashboard)
PROVIDER_01_API_KEY=pk-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Legacy environment variable names for backward compatibility
CAGE_NORMATIVE_ENDPOINT=https://provider-01.sandbox.example.com/api/cage
CAGE_NORMATIVE_API_KEY_SECRET=pk-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Provider 02 (CER Attestation Provider)
# ---------------------------------------------------------------------------

# Provider 02 API endpoint (sandbox)
PROVIDER_02_API_ENDPOINT=https://provider-02.sandbox.example.com/v1

# Provider 02 JWK endpoint for Ed25519 public key manifest (out-of-band resolution)
PROVIDER_02_JWK_ENDPOINT=https://provider-02.sandbox.example.com/.well-known/jwks.json
# Or relative path (will be resolved against API endpoint base):
# PROVIDER_02_JWK_ENDPOINT=/.well-known/jwks.json

# Provider 02 API key (obtain from Provider 02 sandbox dashboard)
PROVIDER_02_API_KEY_SECRET=sk-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Test certificate hash for signature verification tests
# (Obtain by creating a test CER in the sandbox environment)
PROVIDER_02_TEST_CERT_HASH=

# Optional: mTLS client certificate and key paths (if Provider 02 requires mTLS)
PROVIDER_02_CLIENT_CERT=/path/to/client-cert.pem
PROVIDER_02_CLIENT_KEY=/path/to/client-key.pem
PROVIDER_02_CA_BUNDLE=/path/to/ca-bundle.pem

# Optional: Custom ingestion endpoint path
PROVIDER_02_INGEST_PATH=/v1/governance/bundles

# ---------------------------------------------------------------------------
# Provider 03 (Normative Baseline Provider)
# ---------------------------------------------------------------------------

# Provider 03 API endpoint (sandbox)
PROVIDER_03_ENDPOINT=https://provider-03.sandbox.example.com/api

# Provider 03 API key (obtain from Provider 03 sandbox dashboard)
PROVIDER_03_API_KEY=bearer-token-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Test region for baseline retrieval (defaults to EU_ECB)
PROVIDER_03_TEST_REGION=EU_ECB

# ---------------------------------------------------------------------------
# Provider 05 (AO Warrant / Blueprint Provider)
# ---------------------------------------------------------------------------

# Provider 05 blueprint registry URL (sandbox)
PROVIDER_05_BLUEPRINT_REGISTRY_URL=https://provider-05.sandbox.example.com/registry

# Provider 05 API key (if required)
PROVIDER_05_API_KEY=

# Optional: Test threshold ID for warrant retrieval (defaults to THR-FIN-006)
PROVIDER_05_TEST_THRESHOLD_ID=THR-FIN-006

# Optional: Test threshold value for drift detection (defaults to 15000.0)
PROVIDER_05_TEST_THR_FIN_006=15000.0

# ---------------------------------------------------------------------------
# Provider 06 (Agent Integrity Provider)
# ---------------------------------------------------------------------------

# Provider 06 endpoint (sandbox) — if live endpoint exists
PROVIDER_06_ENDPOINT=https://provider-06.sandbox.example.com/api

# Provider 06 API key (if required)
PROVIDER_06_API_KEY=

# ---------------------------------------------------------------------------
# Actuator 01 (Execution Gateway with mTLS + Quorum Signatures)
# ---------------------------------------------------------------------------

# Actuator 01 execution gateway endpoint (sandbox, HTTPS with mTLS)
ACTUATOR_01_ENDPOINT=https://actuator-01.sandbox.example.com

# Actuator 01 mTLS client certificate (PEM format)
ACTUATOR_01_CLIENT_CERT=/path/to/actuator-01-client-cert.pem

# Actuator 01 mTLS client private key (PEM format)
ACTUATOR_01_CLIENT_KEY=/path/to/actuator-01-client-key.pem

# Actuator 01 CA bundle for server verification (PEM format)
ACTUATOR_01_CA_BUNDLE=/path/to/actuator-01-ca-bundle.pem

# Actuator 01 domain tag for quorum signatures (defaults to ACTUATOR_01_DOMAIN_TAG_QUORUM)
ACTUATOR_01_DOMAIN_TAG_QUORUM=cage.actuator_01.quorum.v1

# Actuator 01 domain tag for assertion signatures (defaults to ACTUATOR_01_DOMAIN_TAG_ASSERTION)
ACTUATOR_01_DOMAIN_TAG_ASSERTION=cage.actuator_01.assertion.v1

# ---------------------------------------------------------------------------
# KMS Configuration (Required for Actuator 01 quorum signatures)
# ---------------------------------------------------------------------------

# GCP KMS governance key resource name (for quorum and assertion signing)
# Format: projects/{project}/locations/{location}/keyRings/{ring}/cryptoKeys/{key}/cryptoKeyVersions/{version}
KMS_GOVERNANCE_KEY=projects/your-gcp-project/locations/us-central1/keyRings/cage-governance/cryptoKeys/governance-signing/cryptoKeyVersions/1

# Operator URNs for quorum signatures (comma-separated, minimum 2)
CAGE_OPERATOR_URNS=urn:cage:operator:alice,urn:cage:operator:bob

# ---------------------------------------------------------------------------
# Pytest Configuration
# ---------------------------------------------------------------------------

# Enable partner integration tests (set to any non-empty value)
PYTEST_RUN_PARTNER_INTEGRATION=1

# ---------------------------------------------------------------------------
# Observability & Telemetry (Optional)
# ---------------------------------------------------------------------------

# Disable LangSmith tracing (CAGE uses Langfuse for sovereign telemetry)
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Langfuse configuration (optional for partner integration tests)
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_HOST=https://langfuse.example.com

# ---------------------------------------------------------------------------
# Multi-Provider Attestation & Actuator Loading
# ---------------------------------------------------------------------------
# Comma-separated attestation providers to activate (leave empty for hermetic dev/CI)
CAGE_ATTESTATION_PROVIDERS=provider_02,provider_05

# Comma-separated downstream actuators to activate (leave empty for hermetic dev/CI)
CAGE_ACTIVE_ACTUATORS=actuator_01
