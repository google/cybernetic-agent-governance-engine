# Local Development Environment Configuration for LangGraph SDK
# Copy this file to config/environments/local-dev.env and fill in your values.
# Never commit local-dev.env to version control.

# --- CORE ENVIRONMENT ---
ENVIRONMENT=dev
CAGE_ENV=dev
CAGE_DEPLOYMENT_REGION=US_FED

# --- OBSERVABILITY ---
# Disable cloud tracing and LangSmith for hermetic local operation
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
OTEL_SDK_DISABLED=true

# Langfuse: sovereign telemetry (optional in local dev)
# Leave blank to disable telemetry entirely
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- KMS FALLBACK (BLOCKER 1 Fix) ---
# In local dev, KMS operations fall back to insecure HMAC signing
CAGE_KMS_PROVIDER=gcp
KMS_GOVERNANCE_KEY=
CAGE_ROUTING_SEAL_SECRET=dev-only-insecure-placeholder-not-for-production-use
GOVERNANCE_SALT=dev-only-insecure-placeholder-not-for-production-use

# Seal enforcement mode: log-only in dev (don't block missing seals)
CAGE_SEAL_ENFORCEMENT=log

# --- MODEL CONFIGURATION (BLOCKER 2 Fix: Host Ollama) ---
# LangGraph SDK Local Dev uses the host Ollama instance for inference.
# The gateway service is configured to accept traffic from graph-engine via
# host.docker.internal in docker-compose.local-dev.yml.
USE_MOCK_LLM=false
MODEL_FAST=qwen2.5:3b
MODEL_REASONING=qwen2.5:3b
MODEL_CONSENSUS=qwen2.5:3b

# vLLM API endpoints point to host Ollama /v1 compatibility layer
VLLM_FAST_API_BASE=http://host.docker.internal:11434/v1
VLLM_REASONING_API_BASE=http://host.docker.internal:11434/v1
VLLM_API_KEY=ollama-local-no-key

# Ollama Base URL: points at the host-side Ollama service
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI API key (not used with Ollama; set to any non-empty string)
OPENAI_API_KEY=not-needed-for-ollama

# --- INTER-SERVICE ENDPOINTS ---
# Gateway: governance engine and MCP tool server
CAGE_GATEWAY_URL=http://gateway:8080
GATEWAY_URL=http://gateway:8080

# OPA: policy engine for pre-trade safety checks
OPA_URL=http://opa:8181/v1/data/trade/governance
OPA_AUTH_TOKEN=dev-opa-token

# Redis: checkpoint store (optional, only when using --profile with-redis)
REDIS_URL=redis://checkpoint-store:6379

# --- EXTERNAL DATA SOURCES (Optional) ---
# AlphaVantage API key for market data (leave blank to skip)
ALPHAVANTAGE_API_KEY=

# MCP mode: stdio (local) or sse (remote server)
MCP_MODE=stdio

# --- PROVIDER 06: AGENT INTEGRITY (Phase 2 — Cryptographic Receipts) ---
# Mock endpoint for local testing (Phase 2 includes real Ed25519 signatures)
CAGE_AGENT_INTEGRITY_ENDPOINT=http://localhost:8090
# JWKS manifest for Ed25519 key resolution (use absolute path for file://)
# Example: file:///home/user/cybernetic-governance-engine/tests/integrations/provider_06/fixtures/key_manifest.json
CAGE_AGENT_INTEGRITY_KEY_MANIFEST=
CAGE_AGENT_INTEGRITY_TIMEOUT=10
