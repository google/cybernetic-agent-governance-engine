{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SimranPabla/agent-integrity/schemas/integrity-envelope.schema.json",
  "title": "Agent Integrity Envelope 1-alpha",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "policy", "response", "sources", "decisionRegistryDigest", "decisions", "evidence", "claims"],
  "properties": {
    "protocolVersion": { "const": "1-alpha" },
    "policy": { "$ref": "#/$defs/policy" },
    "response": { "$ref": "#/$defs/response" },
    "sources": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/source" } },
    "decisionRegistryDigest": { "$ref": "#/$defs/sha256" },
    "decisions": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/decision" } },
    "evidence": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/evidence" } },
    "claims": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/claim" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "sources", "decisions", "rules"],
      "properties": {
        "version": { "const": 1 },
        "sources": { "type": "object", "additionalProperties": false, "required": ["allowedRoots"], "properties": { "allowedRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } } } },
        "decisions": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string", "pattern": "\\.ya?ml$" } } },
        "rules": { "type": "object", "additionalProperties": false, "required": ["requireEvidenceFor", "contradictions", "rejectedDecisions", "responseMutation", "replay"], "properties": {
          "requireEvidenceFor": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["factual", "recommendation"] } },
          "contradictions": { "enum": ["review", "block"] }, "rejectedDecisions": { "const": "block" }, "responseMutation": { "const": "block" }, "replay": { "const": "block" }
        } }
      }
    },
    "response": { "type": "object", "additionalProperties": false, "required": ["content", "sections"], "description": "Runtime enforcement limits content to 16777216 UTF-8 bytes. JSON Schema maxLength counts Unicode characters and cannot express this byte limit.", "properties": { "content": { "type": "string" }, "sections": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/section" } } }, "allOf": [{ "if": { "properties": { "content": { "type": "string", "minLength": 1 } } }, "then": { "properties": { "sections": { "type": "array", "minItems": 1 } } }, "else": { "properties": { "sections": { "type": "array", "maxItems": 0 } } } }] },
    "section": { "type": "object", "additionalProperties": false, "required": ["sectionId", "substantive", "byteStart", "byteEnd", "sha256"], "properties": { "sectionId": { "$ref": "#/$defs/nonEmpty" }, "substantive": { "type": "boolean" }, "byteStart": { "$ref": "#/$defs/uint" }, "byteEnd": { "$ref": "#/$defs/uint" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["sourceId", "path", "sha256", "size"], "properties": { "sourceId": { "$ref": "#/$defs/nonEmpty" }, "path": { "$ref": "#/$defs/nonEmpty" }, "sha256": { "$ref": "#/$defs/sha256" }, "size": { "$ref": "#/$defs/uint" } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["eventId", "decisionId", "revision", "action"], "properties": { "eventId": { "$ref": "#/$defs/nonEmpty" }, "decisionId": { "$ref": "#/$defs/nonEmpty" }, "revision": { "type": "integer", "minimum": 1 }, "action": { "enum": ["activate", "reject", "supersede"] }, "supersededBy": { "$ref": "#/$defs/nonEmpty" } }, "allOf": [{ "if": { "properties": { "action": { "type": "string", "const": "supersede" } }, "required": ["action"] }, "then": { "required": ["supersededBy"] }, "else": { "not": { "required": ["supersededBy"] } } }] },
    "anchor": { "type": "object", "additionalProperties": false, "required": ["byteStart", "byteEnd", "sha256"], "properties": { "byteStart": { "$ref": "#/$defs/uint" }, "byteEnd": { "$ref": "#/$defs/uint" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "sourceId"], "properties": { "evidenceId": { "$ref": "#/$defs/nonEmpty" }, "sourceId": { "$ref": "#/$defs/nonEmpty" }, "anchor": { "$ref": "#/$defs/anchor" } } },
    "claimEvidence": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "role"], "properties": { "evidenceId": { "$ref": "#/$defs/nonEmpty" }, "role": { "enum": ["supporting", "contradictory", "contextual"] }, "support": { "enum": ["direct", "ambiguous"] }, "disclosed": { "type": "boolean" } }, "allOf": [{ "if": { "properties": { "role": { "type": "string", "const": "supporting" } }, "required": ["role"] }, "then": { "not": { "required": ["disclosed"] } } }, { "if": { "properties": { "role": { "type": "string", "const": "contradictory" } }, "required": ["role"] }, "then": { "not": { "required": ["support"] } } }, { "if": { "properties": { "role": { "type": "string", "const": "contextual" } }, "required": ["role"] }, "then": { "not": { "anyOf": [{ "required": ["support"] }, { "required": ["disclosed"] }] } } }] },
    "claim": { "type": "object", "additionalProperties": false, "required": ["claimId", "sectionId", "kind", "decisionIds", "evidence"], "properties": { "claimId": { "$ref": "#/$defs/nonEmpty" }, "sectionId": { "$ref": "#/$defs/nonEmpty" }, "kind": { "enum": ["factual", "recommendation", "inference"] }, "decisionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }, "evidence": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/claimEvidence" } } } }
  }
}
