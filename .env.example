# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Cloud-Agnostic Sovereign Stack Configuration
# This project runs on any Kubernetes cluster, local Docker Compose, or bare metal.
# No Google Cloud account is required.

# --- MODEL CONFIGURATION (Sovereign / Open Weights) ---

# CAGE Model Configuration
MODEL_REASONING=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
MODEL_FAST=Qwen/Qwen2.5-1.5B-Instruct
MODEL_CONSENSUS=deepseek-ai/DeepSeek-R1-Distill-Llama-8B

# --- INFERENCE INFRASTRUCTURE ---

# Option A: Local Split-Brain (Direct Connection)
# Default for Docker Compose / Local Development
VLLM_REASONING_API_BASE=http://localhost:8000/v1
VLLM_FAST_API_BASE=http://localhost:8001/v1

# Option B: K8s Inference Gateway (Unified Endpoint)
# Set this for Production to enable Priority Handling & Autoscaling.
# If set, VLLM_REASONING_API_BASE and VLLM_FAST_API_BASE are ignored.
# VLLM_GATEWAY_URL=http://<GATEWAY_IP>/v1

# OpenAI-compatible API key (set to any non-empty string for local vLLM)
OPENAI_API_KEY=not-needed-for-local-vllm

# Policy Transpiler model (defaults to MODEL_FAST if unset)
# TRANSPILER_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- SERVICE CONFIGURATION ---
PORT=8080
REDIS_URL=redis://localhost:6379

# --- SIDECARS ---
# OPA Policy Engine
OPA_URL=http://localhost:8181/v1/data/trade/governance
OPA_AUTH_TOKEN=

# Python Sandbox (Computer Use)
SANDBOX_URL=http://localhost:8081/execute

# --- TELEMETRY & OBSERVABILITY ---

# Langfuse Configuration (Self-Hosted — use docker-compose.yml or your own K8s deployment)
# Leave host blank to use SaaS (https://cloud.langfuse.com)
LANGFUSE_HOST=https://<YOUR_LANGFUSE_HOST>
LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=<YOUR_BUCKET_NAME>

# OTLP endpoint resolution — priority order (no restart needed after changing):
#
#   1. OTEL_EXPORTER_OTLP_ENDPOINT (set explicitly)
#        → Used as-is; no extra auth headers injected.
#          Use this to point at a local OpenTelemetry Collector or Jaeger.
#
#   2. LANGFUSE_HOST + LANGFUSE_PUBLIC_KEY + LANGFUSE_SECRET_KEY (above)
#        → Auto-derives: {LANGFUSE_HOST}/api/public/otel  with HTTP Basic Auth.
#          Spans flow directly into Langfuse's OTLP ingestion pipeline.
#          Langfuse's own S3 worker archives all received spans to the cold tier
#          bucket configured in your Langfuse deployment (no app-side S3 exporter).
#
#   3. Fallback → http://localhost:4318  (no auth headers)
#
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to use the LANGFUSE_HOST auto-derive.
# OTEL_EXPORTER_OTLP_ENDPOINT=

TRACE_SAMPLING_RATE=0.01

# High-Fidelity Tracing (Payload Capture)
OTEL_PYTHON_INSTRUMENTATION_HTTPX_CAPTURE_REQUEST_BODY=true
OTEL_PYTHON_INSTRUMENTATION_HTTPX_CAPTURE_RESPONSE_BODY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Cold Tier Storage bucket name (S3 / MinIO bucket, not GCS-specific).
# Set STORAGE_BACKEND and S3_* vars below to control the backend.
COLD_TIER_BUCKET=cage-cold-tier
COLD_TIER_PREFIX=cold_tier

# --- EXTERNAL TOOLS ---

# MCP Configuration (AlphaVantage)
# Mode: 'stdio' (local execution via uvx) or 'sse' (remote server)
MCP_MODE=stdio
ALPHAVANTAGE_API_KEY=<YOUR_ALPHAVANTAGE_KEY>

# --- STORAGE BACKEND (S3-compatible: MinIO, AWS S3, Wasabi, Backblaze B2, etc.) ---
#
# Default: s3 (MinIO is pre-configured in docker-compose.yml)
# Options: s3 | local | gcs
STORAGE_BACKEND=s3

# S3 / MinIO configuration
# For local Docker Compose MinIO:
S3_ENDPOINT_URL=http://minio:9000
S3_PATH_STYLE=true
S3_BUCKET_NAME=cage-artifacts
S3_REGION_NAME=us-east-1

# S3 credentials (MinIO uses these as access/secret key)
AWS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<YOUR_SECRET_KEY>

# OSCAL artifact storage (reuses the same S3-compatible endpoint by default)
OSCAL_S3_ENDPOINT=http://minio:9000
OSCAL_S3_BUCKET=cage-oscal-artifacts

# Local filesystem path used when STORAGE_BACKEND=local.
LOCAL_STORAGE_DIR=/tmp/cage-storage

# Container image registry URL (GHCR, DockerHub, or any OCI-compatible registry)
# Example: ghcr.io/your-org/cybernetic-governance-engine
REGISTRY_URL=ghcr.io/<YOUR_ORG>/cybernetic-governance-engine

# Hugging Face (for gated model access)
HUGGING_FACE_HUB_TOKEN=<YOUR_HF_TOKEN>

# --- ISO 42001 CONTINUOUS COMPLIANCE (Lula + Langfuse Bridge) ---

# Langfuse keys for the *dedicated compliance project* (audit traces are isolated
# from the main application performance project above).
LANGFUSE_COMPLIANCE_PUBLIC_KEY=<YOUR_COMPLIANCE_LANGFUSE_PUBLIC_KEY>
LANGFUSE_COMPLIANCE_SECRET_KEY=<YOUR_COMPLIANCE_LANGFUSE_SECRET_KEY>

# Alert channel for CRITICAL ISO 42001 failures (A.9.2 Data Privacy or SC-4 Fiscal Limits).
#
#   console  — Pretty-prints the full alert payload as JSON to stdout.
#              Zero external dependencies. Visible in `kubectl logs`.
#              Use this in LOCAL DEV and CI. (DEFAULT when var is blank/missing)
#
#   slack    — Posts Slack Block Kit payloads to COMPLIANCE_ALERT_WEBHOOK_URL.
#              Use this in PRODUCTION.  Requires COMPLIANCE_ALERT_WEBHOOK_URL below.
#
#   mock     — Captures calls in-memory, no I/O. For unit tests only.
#
ALERT_CHANNEL=console

# Slack incoming webhook URL.
# Only required when ALERT_CHANNEL=slack.
COMPLIANCE_ALERT_WEBHOOK_URL=

# Container image for the langfuse-bridge Mastra service.
LANGFUSE_BRIDGE_IMAGE=

# Cold-start grace period (hours) before Lula enforces total_traces > 100.
STARTUP_GRACE_HOURS=6

# ISO 8601 timestamp injected at deploy time so the bridge can compute
# deployment age for the cold-start grace window.
DEPLOYMENT_START_UTC=

# --- GOVERNANCE ---
# Salt used for HMAC signatures in the governance gateway.
GOVERNANCE_SALT=  # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Gateway Routing Seal — NIST SC-12/AC-3 Control (POAM-012)
CAGE_ROUTING_SEAL_SECRET=          # REQUIRED in production; absence raises RuntimeError
ENVIRONMENT=development            # Set to 'production' in prod deployments

# v2.0.0 Regional Compliance Profile Selector (ControlRegistry boot contract)
# Determines which config/compliance/*_BASELINE.json file governs ALL runtime controls.
# Must be set explicitly in every deployment manifest (K8s Deployment, Docker Compose).
# Omitting this var causes a silent fallback to US_FED — UNACCEPTABLE for EU/APAC deployments.
#
#   US_FED   → config/compliance/US_FED_BASELINE.json   (SR 26-2 / NIST AI RMF / ISO 42001)
#   EU_ECB   → config/compliance/EU_ECB_BASELINE.json   (EU AI Act / DORA / GDPR / EBA)
#   APAC_MAS → config/compliance/APAC_MAS_BASELINE.json (MAS FEAT / MAS TRM / ISO 42001)
#
# To swap at runtime (e.g. container init): ControlRegistry.reconfigure("EU_ECB")
CAGE_DEPLOYMENT_REGION=US_FED

# Automated Auditor — NIST AU-12/SI-4 Control (POAM-003)
AUDITOR_TRACE_SOURCE=otlp          # Options: otlp, cloudtrace, mock (mock=testing only)
AUDITOR_OTLP_ENDPOINT=http://localhost:4318
AUDITOR_GCP_PROJECT_ID=            # Required if AUDITOR_TRACE_SOURCE=cloudtrace

# --- KUBERNETES DEPLOYMENT (cloud-agnostic) ---
# Cluster name for kubectl context (any K8s provider: k3s, EKS, AKS, GKE, etc.)
K8S_CLUSTER_NAME=governance-cluster

# K8s namespace
K8S_NAMESPACE=governance-stack
