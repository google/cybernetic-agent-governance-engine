# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TERRAFORM AUTO-LOADED SECRETS (terraform.auto.tfvars)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# This file contains sensitive secrets and credentials that are auto-loaded by
# Terraform. Copy this file to `terraform.auto.tfvars` and populate with your
# actual secrets.
#
# ⚠️  SECURITY WARNING: terraform.auto.tfvars is gitignored. NEVER commit it.
#
# Generate secrets using:
#   openssl rand -hex 32
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── GCP Project Configuration ────────────────────────────────────────────────

project_id = "your-gcp-project-id"

# ─── Gateway Routing Seal Secrets ─────────────────────────────────────────────
# REQUIRED: Used for cryptographic request routing and integrity seals
# Generate via: openssl rand -hex 32

routing_seal_secret = "REPLACE_WITH_64_CHAR_HEX_STRING"
routing_seal_salt   = "REPLACE_WITH_64_CHAR_HEX_STRING"

# ─── Langfuse Authentication Secrets ──────────────────────────────────────────
# REQUIRED: Used for Langfuse NextAuth.js and encryption
# Generate via: openssl rand -hex 32

langfuse_nextauth_secret = "REPLACE_WITH_64_CHAR_HEX_STRING"
langfuse_salt            = "REPLACE_WITH_64_CHAR_HEX_STRING"

# ─── Langfuse API Keys (Optional) ─────────────────────────────────────────────
# Optional: For trace ingestion from external clients
# Obtain from Langfuse UI: Settings → API Keys

langfuse_public_key = ""
langfuse_secret_key = ""

# ─── Langfuse Compliance Project Keys (NIST Compliance Only) ─────────────────
# REQUIRED when enable_nist_compliance=true (POAM-019)
# Separate Langfuse project for AU-9 dual-project telemetry isolation

langfuse_compliance_public_key = ""
langfuse_compliance_secret_key = ""

# ─── Container Images (Optional) ──────────────────────────────────────────────
# Leave empty to use defaults: gcr.io/{project_id}/cage-{service}:latest

gateway_image            = ""
governed_advisor_image   = ""
agentsight_ui_image      = ""
compliance_bridge_image  = ""
langfuse_web_image       = "langfuse/langfuse:latest"
langfuse_worker_image    = "langfuse/langfuse-worker:latest"
