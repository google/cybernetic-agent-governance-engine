# GCP-GKE Terraform Variables (Auto-loaded)
# 
# Copy this file to terraform.auto.tfvars and fill in your values.
# Alternatively, source ../../load_env.sh to load values from .env
#
# IMPORTANT: Never commit terraform.auto.tfvars to version control!

# ═══════════════════════════════════════════════════════════════════════════════
# GCP Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# GCP project ID (REQUIRED)
project_id = "your-gcp-project-id"

# GCP region (default: us-central1)
region = "us-central1"

# GCP zone (default: us-central1-a)
zone = "us-central1-a"

# ═══════════════════════════════════════════════════════════════════════════════
# Cluster Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Cluster name (will be visible in GCP Console)
cluster_name = "cage-gke"

# Environment: dev, staging, or prod
# This affects resource sizing, HA settings, and security posture
environment = "dev"

# Kubernetes namespace for all CAGE resources
namespace = "governance-stack"

# ═══════════════════════════════════════════════════════════════════════════════
# Security Posture (NIST RMF Controls)
# ═══════════════════════════════════════════════════════════════════════════════

# Enable NIST compliance controls (SC-7, AC-3, deletion protection)
# When true: enables HA Redis, backups, resource limits, PodDisruptionBudgets
enable_nist_compliance = false

# Enable Binary Authorization (CM-7, SI-7)
# Requires: Binary Authorization policy configured in GCP
enable_binary_authorization = false

# Enable comprehensive audit logging (AU-2, AU-3, AU-9)
enable_audit_logging = false

# Enable Customer-Managed Encryption Keys (SC-12, SC-13)
# Requires: KMS key created and kms_key_id set below
enable_cmek = false

# Make Kubernetes API endpoint private (requires Cloud VPN or Interconnect)
enable_private_master_endpoint = false

# Enable Pod Security Standards in namespace
enable_pod_security_standards = false

# Pod Security Standard level (baseline or restricted)
pod_security_level = "baseline"

# ═══════════════════════════════════════════════════════════════════════════════
# NIST Compliance - Advanced Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Master authorized networks (SC-7: Boundary Protection)
# Only these CIDR ranges can access the Kubernetes API
# authorized_networks = [
#   {
#     cidr         = "203.0.113.0/24"
#     display_name = "Corporate VPN"
#   }
# ]

# Cloud KMS key ID for application-layer secrets encryption
# Format: projects/PROJECT_ID/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
# kms_key_id = ""

# ═══════════════════════════════════════════════════════════════════════════════
# Node Pool Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Primary node pool (CPU workloads: backend, Langfuse, OPA, etc.)
primary_node_pool_machine_type = "e2-standard-4"  # 4 vCPU, 16 GB RAM
primary_node_pool_min_count = 1
primary_node_pool_max_count = 5
primary_node_pool_initial_count = 2
primary_node_pool_disk_type = "pd-standard"  # or "pd-ssd" for production

# GPU node pool (vLLM inference)
enable_gpu_node_pool = true
gpu_type = "nvidia-l4"  # Options: nvidia-l4, nvidia-t4, nvidia-a100-80gb
gpu_count = 1  # GPUs per node
gpu_node_pool_machine_type = "g2-standard-4"  # L4 GPU, 4 vCPU, 16 GB RAM
gpu_node_pool_min_count = 0  # Scale to zero when idle
gpu_node_pool_max_count = 2
gpu_node_pool_initial_count = 1

# ═══════════════════════════════════════════════════════════════════════════════
# Storage Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Storage class for persistent volumes
minio_storage_class = "pd-standard"  # or "pd-ssd"

# MinIO object storage size
minio_storage_size = "100Gi"

# MinIO credentials (auto-generated if empty)
# minio_root_user = ""
# minio_root_password = ""

# PostgreSQL storage size (Langfuse database)
postgres_storage_size = "50Gi"

# Redis storage size (application cache)
redis_storage_size = "10Gi"

# GCS bucket for model weights (defaults to ${project_id}-models if empty)
# model_bucket_name = ""

# ═══════════════════════════════════════════════════════════════════════════════
# vLLM Inference Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Enable vLLM deployment
enable_vllm = false

# Model path (HuggingFace ID or GCS path)
vllm_model_path = "meta-llama/Llama-3.2-3B-Instruct"

# GPUs per vLLM pod
vllm_gpu_count = 1

# Number of vLLM replicas
vllm_replicas = 1

# ═══════════════════════════════════════════════════════════════════════════════
# Langfuse Observability
# ═══════════════════════════════════════════════════════════════════════════════

# Langfuse external URL (for NextAuth)
langfuse_nextauth_url = "http://localhost:3000"

# ═══════════════════════════════════════════════════════════════════════════════
# Compliance Bridge
# ═══════════════════════════════════════════════════════════════════════════════

# Enable compliance bridge (Langfuse → Lula integration)
enable_compliance_bridge = false

# Compliance bridge container image
# compliance_bridge_image = "gcr.io/your-project/compliance-bridge:latest"

# ═══════════════════════════════════════════════════════════════════════════════
# OPA Policy Engine
# ═══════════════════════════════════════════════════════════════════════════════

# OPA custom policy files (name -> content)
# opa_policy_files = {
#   "custom_policy.rego" = file("${path.root}/policies/custom_policy.rego")
# }

# ═══════════════════════════════════════════════════════════════════════════════
# Container Registry
# ═══════════════════════════════════════════════════════════════════════════════

# Container registry URL (defaults to gcr.io/${project_id} if empty)
# registry_url = "us-central1-docker.pkg.dev/your-project/cage"

# ═══════════════════════════════════════════════════════════════════════════════
# GCP-Specific Features
# ═══════════════════════════════════════════════════════════════════════════════

# Enable GCS Fuse CSI driver for streaming model weights from GCS
enable_gcs_fuse_csi = true

# ═══════════════════════════════════════════════════════════════════════════════
# Deployment Control
# ═══════════════════════════════════════════════════════════════════════════════

# Force redeployment of application (ignores content hash)
force_redeploy = false
