# NeMo Guardrails image (the GKE `nemo-guardrails` workload).
#
# Two-stage build on the same digest-pinned Wolfi base as the advisor, gateway
# and compliance-bridge images (see the comment in the repo-root Dockerfile).
# The builder stage holds the compiler, uv and grpcio-tools; the runtime stage
# receives only the locked venv, the generated protobuf stubs and the source.
# To bump the base, update WOLFI_BASE here together with the other three
# Python Dockerfiles.
ARG WOLFI_BASE=cgr.dev/chainguard/wolfi-base@sha256:9c2092b053779e14c82fb50f77b37bcc38b7d2c83972352d5813280f9d035b03

# ---------------------------------------------------------------------------
# Stage 1 — builder
# ---------------------------------------------------------------------------
FROM ${WOLFI_BASE} AS builder

WORKDIR /app

# Interpreter, its headers, and the build toolchain (builder only).
# No system protoc: grpcio-tools bundles its own compiler.
RUN apk add --no-cache python-3.12 python-3.12-dev build-base

# Install uv for dependency management (builder only — not shipped at runtime)
COPY --from=ghcr.io/astral-sh/uv:0.12.2 /uv /bin/uv

# Use the system interpreter so the venv's python symlink
# (/usr/bin/python3.12) resolves identically in the runtime stage.
ENV UV_PYTHON=/usr/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy

# Copy dependency definitions — both files required for uv sync --frozen
COPY pyproject.toml uv.lock ./

# Create virtual env
RUN uv venv
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Install gateway extras which include nemoguardrails, grpcio, presidio, spaCy.
# --no-dev skips test/lint extras; --no-install-project avoids the project
# package install step (source is imported directly via PYTHONPATH=/app).
# --extra compliance pulls dowhy (Tier 6 causal gatekeeper, No-Direct-Bind Gap 4)
RUN uv sync --frozen --no-dev --extra gateway --extra compliance --extra advisor --no-install-project

# Copy NeMo Guardrails source and config
COPY src/cybernetic_governance_engine /app/src/cybernetic_governance_engine
COPY src/gateway /app/src/gateway
COPY src/cage_finance /app/src/cage_finance
COPY src/integrations /app/src/integrations
COPY config /app/config
COPY README.md /app/README.md

# Generate protobuf Python bindings from nemo.proto. grpcio-tools runs from an
# isolated `uv tool run` environment, so it never enters the runtime venv, which stays
# exactly as locked. Keep its version equal to grpcio in uv.lock.
RUN uv tool run --from grpcio-tools==1.81.1 python -m grpc_tools.protoc \
  -I /app/src/gateway/protos \
  --python_out=/app/src/gateway/protos \
  --grpc_python_out=/app/src/gateway/protos \
  /app/src/gateway/protos/nemo.proto && \
  # Fix the generated grpc stub: protoc emits `import nemo_pb2` (bare),
  # but with PYTHONPATH=/app the module lives at src.gateway.protos.nemo_pb2.
  sed -i 's/^import nemo_pb2 as nemo__pb2$/from src.gateway.protos import nemo_pb2 as nemo__pb2/' \
  /app/src/gateway/protos/nemo_pb2_grpc.py

# Install the project itself so entry-point metadata exists in the image.
RUN uv pip install --no-deps .

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM ${WOLFI_BASE}

WORKDIR /app

# Runtime interpreter plus the C++ runtime that native wheels link against.
# `apk upgrade` picks up fixes published since the base digest was cut.
# Non-root user matching runAsUser: 1000 in deployment/k8s/nemo.yaml.
# Application files stay root-owned, so the process cannot modify its own code.
RUN apk upgrade --no-cache \
    && apk add --no-cache python-3.12 libstdc++ libgcc tzdata \
    && adduser -D -H -u 1000 -s /bin/false appuser

COPY --from=builder /app /app

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

USER appuser

# NeMo Guardrails server listens on port 8000
ARG PORT=8000
ENV PORT=$PORT
EXPOSE $PORT

# Start the NeMo Guardrails server (FastAPI via uvicorn)
CMD ["python", "src/integrations/nemo/server.py"]
