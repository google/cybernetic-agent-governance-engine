FROM python:3.12-slim

WORKDIR /app

# Install uv for dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency definitions — both files required for uv sync --frozen
# Build context must be the monorepo root so pyproject.toml and uv.lock are reachable
COPY pyproject.toml uv.lock ./

# Install only the slm extra (flask + sentence-transformers).
# --frozen enforces the lockfile; --no-dev skips test/lint extras.
RUN uv sync --frozen --no-dev --extra slm --no-install-project

# Copy SLM sidecar source
COPY src/gateway/slm/ ./src/gateway/slm/

# Pre-download model weights during build to speed up container startup
# This downloads the all-MiniLM-L6-v2 model (~90MB) into the image layer
# Use uv's virtualenv directly without installing the project
ENV TRANSFORMERS_CACHE=/app/.cache/transformers
ENV HF_HOME=/app/.cache/huggingface

RUN . .venv/bin/activate && \
    python -c "from sentence_transformers import SentenceTransformer; print('Downloading model...'); model = SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2'); print('Model cached successfully')"

ENV SLM_PORT=5001

CMD ["uv", "run", "--no-sync", "python", "src/gateway/slm/slm_server.py"]
