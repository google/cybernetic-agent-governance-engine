# ── vLLM Streamer Image ────────────────────────────────────────────────────────
# Extends the official vLLM OpenAI-compatible server with:
#   - RunAI model streamer for GCS tensor streaming (gcs_filesystem load format)
#   - google-cloud-storage SDK for ADC / Workload Identity authentication
#
# The GCS streamer allows vLLM to load model weights directly from a GCS bucket
# without downloading them to local disk first, enabling faster cold starts on
# GKE nodes with limited ephemeral storage.
#
# Usage (via Terraform vllm_inference module):
#   model_path = "gs://laah-cybernetics-models/models--Qwen--Qwen2.5-7B-Instruct/..."
#   vllm_load_format = "gcs_filesystem"
# ──────────────────────────────────────────────────────────────────────────────

FROM vllm/vllm-openai:latest

# Optional: Hugging Face Hub token for gated model downloads.
# Passed as a build-time ARG so it is not baked into any image layer.
ARG HF_TOKEN=""
ENV HUGGING_FACE_HUB_TOKEN=${HF_TOKEN}

# Install RunAI model streamer and GCS backend.
# runai-model-streamer-gcs requires google-cloud-storage for ADC auth.
RUN pip install --no-cache-dir \
    runai-model-streamer \
    runai-model-streamer-gcs \
    google-cloud-storage

# The entrypoint is inherited from vllm/vllm-openai:latest:
#   python3 -m vllm.entrypoints.openai.api_server
# Model path, port, and other flags are passed via Kubernetes args/command.
