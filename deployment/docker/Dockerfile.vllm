ARG VLLM_BASE_IMAGE="vllm/vllm-openai:v0.7.3@sha256:4f4037303e8c7b69439db1077bb849a0823517c0f785b894dc8e96d58ef3a0c2"
FROM ${VLLM_BASE_IMAGE}

# Model weights are mirrored to GCS out-of-band by operators and streamed at
# runtime via GKE Workload Identity (`runai_streamer`). Never pass or bake
# Hugging Face credentials into this image.

# Install RunAI model streamer and GCS backend pinned to exact versions.
# runai-model-streamer-gcs requires google-cloud-storage for ADC auth.
RUN pip install --no-cache-dir \
    "runai-model-streamer==0.11.0" \
    "runai-model-streamer-gcs==0.11.0" \
    "google-cloud-storage==2.19.0" \
    && (id -u 1000 >/dev/null 2>&1 || useradd --uid 1000 --user-group --no-create-home --shell /usr/sbin/nologin vllm)

# Inject root-owned (0644) runtime hook so gs:// model paths are handled transparently.
COPY --chmod=0644 deployment/docker/vllm_sitecustomize.py /etc/python3.12/sitecustomize.py
RUN cp -f /etc/python3.12/sitecustomize.py /usr/local/lib/python3.12/dist-packages/sitecustomize.py \
    && chmod 0644 /usr/local/lib/python3.12/dist-packages/sitecustomize.py

ENV HOME=/tmp \
    TMPDIR=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

USER 1000:1000

# The entrypoint is inherited from the vllm/vllm-openai base image:
#   python3 -m vllm.entrypoints.openai.api_server
# Model path, port, and other flags are passed via Kubernetes args/command.
