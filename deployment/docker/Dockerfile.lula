# ─── Stage 1: Builder — compile lula from source ──────────────────────────────
FROM golang:1.22-alpine AS builder

ARG LULA_VERSION=0.9.5

RUN apk add --no-cache git ca-certificates

WORKDIR /build

RUN git clone --depth 1 --branch v${LULA_VERSION} \
    https://github.com/defenseunicorns/lula.git . && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -X github.com/defenseunicorns/lula/src/cmd.version=v${LULA_VERSION}" \
    -o /usr/local/bin/lula ./cmd/lula

# ─── Stage 2: Runtime image ───────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /usr/local/bin/lula /usr/local/bin/lula
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

ENTRYPOINT ["/usr/local/bin/lula"]
