FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git ca-certificates curl jq

# Build lula v0.8.1 from source
WORKDIR /build
RUN git clone --depth=1 --branch v0.8.1 https://github.com/defenseunicorns/lula.git . || \
    git clone --depth=1 https://github.com/defenseunicorns/lula.git . && git checkout v0.8.1 || \
    go install github.com/defenseunicorns/lula@v0.8.1

# If the clone worked, build the binary
RUN if [ -f go.mod ]; then \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /usr/local/bin/lula ./cmd/lula/; \
    fi

# ─── Stage 2: Runtime image ───────────────────────────────────────────────────
FROM alpine:3.19

RUN apk add --no-cache ca-certificates curl jq bash

COPY --from=builder /usr/local/bin/lula /usr/local/bin/lula

RUN chmod +x /usr/local/bin/lula

ENTRYPOINT ["/usr/local/bin/lula"]
