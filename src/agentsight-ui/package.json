{
  "name": "agentsight-ui",
  "private": true,
  "description": "Monitoring and Governance UI for the Cybernetic Agent Governance Engine (CAGE)",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:proto": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/protos --ts_proto_opt=esModuleInterop=true,outputServices=false,onlyTypes=false,useOptionals=messages --proto_path=gateway_protos gateway_protos/gateway.proto gateway_protos/nemo.proto",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "ai": "^7.0.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "ts-proto": "^2.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}