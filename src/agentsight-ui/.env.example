# Agentsight UI — environment variables
# Copy this file to .env.local and fill in the values for local development.

# Base URL of the Python FastAPI compliance-bridge backend.
# In development: run uvicorn in src/compliance_bridge/ (defaults to port 3001)
# In production:  set to the internal service URL (e.g. http://compliance-bridge:80)
VITE_BACKEND_URL=http://localhost:3001
